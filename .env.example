# Place real values only in gitignored .env.local. Never add NEXT_PUBLIC secrets.
# Hosted Supabase config; keep migration credentials out of API/web processes.
SUPABASE_PROJECT_URL=https://PROJECT.supabase.co
APPROVED_DEV_PROJECT_REF=PROJECT
AUTH_PUBLISHABLE_KEY=replace-with-publishable-key
MIGRATION_DATABASE_URL=postgresql://MIGRATOR:PASSWORD@SESSION-POOLER:5432/postgres?sslmode=require
DATABASE_URL=postgresql://billshield_app:PASSWORD@SESSION-POOLER:5432/postgres?sslmode=require
AUTH_ISSUER=https://PROJECT.supabase.co/auth/v1
AUTH_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
AUTH_USERINFO_URL=https://PROJECT.supabase.co/auth/v1/user
AUTH_AUDIENCE=authenticated
S3_ENDPOINT_URL=https://PROJECT.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret
S3_BUCKET=billshield-uploads
UPLOAD_TTL_SECONDS=120
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-username
SMTP_PASSWORD=replace-with-secret
SMTP_FROM=replace-with-verified-sender
SMTP_STARTTLS=true
# Server-only DeepSeek credential, entered locally by the founder.
DEEPSEEK_API_KEY=
# Local Compose LOCAL_* secrets are generated by node scripts/dev-init.mjs.
# Never copy the hosted DATABASE_URL into local Compose or vice versa.
